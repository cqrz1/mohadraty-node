<%- include('../partials/student_top', { title: title }) %>
<div class="container py-5">
  <div class="text-center mb-5 mt-4">
    <div class="bg-primary bg-opacity-10 d-inline-block p-3 rounded-circle mb-3">
      <i class="bi bi-mortarboard text-primary" style="font-size: 2.5rem;"></i>
    </div>
    <h1 class="fw-bold mb-1"><%= professor.professor_name %></h1>
    <p class="text-muted">محتوى مادة <%= professor.subject_name %></p>
  </div>

  <div class="row justify-content-center g-4 w-100 mx-auto" style="max-width: 900px;">
    <div class="col-md-6">
      <a href="/lectures" class="card p-5 text-center shadow-sm text-decoration-none border-0 h-100">
        <div class="bg-primary text-white p-3 rounded-4 d-inline-block mx-auto mb-3 shadow">
          <i class="bi bi-play-btn" style="font-size: 2.5rem;"></i>
        </div>
        <h2 class="fw-bold mt-2 mb-2">المحاضرات</h2>
        <p class="text-muted small">تصفح العروض التقديمية وملفات الشرح</p>
      </a>
    </div>

    <div class="col-md-6">
      <a href="/sheets" class="card p-5 text-center shadow-sm text-decoration-none border-0 h-100">
        <div class="bg-info text-white p-3 rounded-4 d-inline-block mx-auto mb-3 shadow">
          <i class="bi bi-file-earmark-text" style="font-size: 2.5rem;"></i>
        </div>
        <h2 class="fw-bold mt-2 mb-2">الشيتات</h2>
        <p class="text-muted small">تمارين وأسئلة إضافية وقسم التدريبات</p>
      </a>
    </div>
  </div>

  <div class="text-center mt-5">
    <a href="/dashboard" class="btn btn-outline-secondary rounded-pill px-5 shadow-sm">
      <i class="bi bi-arrow-right me-1"></i> العودة لقائمة المواد
    </a>
  </div>
</div>
<%- include('../partials/student_bottom') %>
