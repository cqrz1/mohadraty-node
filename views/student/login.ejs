<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>محاضراتي - تسجيل الدخول</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/style.css?v=7.0">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    .login-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -2; background: var(--bg-main); }
    .login-blob { position: absolute; width: 500px; height: 500px; background: var(--primary-gradient); filter: blur(100px); opacity: 0.1; border-radius: 50%; z-index: -1; }
  </style>
</head>
<body>
  <div class="login-bg">
    <div class="login-blob" style="top: -100px; left: -100px;"></div>
    <div class="login-blob" style="bottom: -100px; right: -100px; background: var(--secondary);"></div>
  </div>

  <nav class="navbar navbar-expand-lg fixed-top shadow-sm">
    <div class="container">
      <span class="navbar-brand fw-bold"><i class="bi bi-mortarboard-fill me-2"></i>محاضراتي</span>
    </div>
  </nav>

  <div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh; padding-top: 100px; padding-bottom: 50px;">
    <div class="row justify-content-center w-100 mx-auto">
      <div class="col-lg-4 col-md-6 mb-4 mx-auto">
        <div class="card login-container shadow-lg border-0">
          <div class="text-center mb-3">
            <div class="login-icon-box shadow-sm"><i class="bi bi-person-badge"></i></div>
            <h2 class="fw-extrabold text-primary mb-1" style="font-weight: 800; font-size: 1.6rem;">مرحبًا بك مجددًا</h2>
            <p class="text-muted small fw-medium mb-0">سجل بياناتك للوصول إلى محاضراتك</p>
          </div>

          <form action="/login" method="post">
            <div class="mb-2 text-end">
              <label class="form-label fw-bold small text-muted px-3 mb-1"><i class="bi bi-card-heading me-1"></i> كود الكارنيه</label>
              <input type="text" name="student_id" class="form-control" placeholder="أدخل الكود الخاص بك" value="<%= formData.student_id || '' %>">
            </div>

            <div class="mb-3 text-end">
              <label class="form-label fw-bold small text-muted px-3 mb-1"><i class="bi bi-person-lines-fill me-1"></i> الاسم الرباعي</label>
              <input type="text" name="student_name" class="form-control" placeholder="الاسم كما في الكارنيه" value="<%= formData.student_name || '' %>">
            </div>

            <button class="btn btn-primary w-100 py-3 mb-2 shadow-lg fw-bold rounded-pill" type="submit">دخول المحتوى التعليمي</button>
          </form>

          <div class="pt-2 border-top border-opacity-10 text-center">
            <a href="/admin/login" class="text-decoration-none text-danger small fw-bold">
              <i class="bi bi-shield-lock me-1"></i>بوابة المسؤولين
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const msg = '<%- (message || "").replace(/'/g, "\\'") %>';
      const msgType = '<%= messageType || "error" %>';
      if (msg) {
        Swal.fire({
          icon: msgType,
          title: 'تنبيه',
          text: msg,
          confirmButtonText: 'حسنًا',
          customClass: { confirmButton: 'btn btn-primary px-4 rounded-pill' },
          buttonsStyling: false
        });
      }
    });
  </script>
</body>
</html>
