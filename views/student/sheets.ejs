<%- include('../partials/student_top', { title: title }) %>
<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-5">
    <div class="d-flex align-items-center gap-3">
      <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
        <i class="bi bi-file-earmark-text-fill fs-4"></i>
      </div>
      <div>
        <h2 class="fw-bold mb-0">الشيتات والتدريبات</h2>
        <p class="text-muted small mb-0">ملفات التقويم والتدريبات العملية المتوفرة</p>
      </div>
    </div>
    <a href="/professor" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
      <i class="bi bi-arrow-right me-1"></i> عودة
    </a>
  </div>

  <% if (message) { %>
  <div class="alert alert-danger mb-4 d-block rounded-4 shadow-sm"><%= message %></div>
  <% } %>

  <div class="row g-3">
    <% sheets.forEach((sheet) => { %>
    <div class="col-12">
      <div class="card border-0 shadow-sm p-3 action-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div class="d-flex align-items-center gap-3">
            <div class="bg-info bg-opacity-10 p-2 rounded-3 text-info shadow-sm">
              <i class="bi bi-clipboard-check" style="font-size: 1.5rem;"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-0"><%= sheet.sheet_name %></h6>
              <small class="text-muted">د. <%= sheet.professor_name %></small>
            </div>
          </div>
          <a href="/<%= sheet.sheet_file %>" target="_blank" class="btn btn-info text-white rounded-pill px-4 shadow-sm">
            <i class="bi bi-cloud-arrow-down me-2"></i>تحميل الشيت
          </a>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <% if (!sheets.length) { %>
  <div class="text-center py-5">
    <i class="bi bi-folder-x text-muted opacity-25" style="font-size: 5rem;"></i>
    <h5 class="text-muted mt-3">لا توجد شيتات متاحة حالياً لمادة هذا الدكتور.</h5>
  </div>
  <% } %>
</div>
<%- include('../partials/student_bottom') %>
