<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>محاضراتي - الإدارة - <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/admin-style.css?v=5.0">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
  <nav class="navbar navbar-expand-lg fixed-top shadow-sm" style="z-index: 1050;">
    <div class="container">
      <a href="/admin" class="navbar-brand fw-bold text-decoration-none">
        <i class="bi bi-shield-lock-fill me-2"></i>محاضراتي <span class="small fw-light">| الإدارة</span>
      </a>

      <div class="d-flex align-items-center gap-3">
        <button type="button" class="btn btn-outline-primary border-2 rounded-pill px-3 d-lg-none" id="sidebar-toggle">
          <i class="bi bi-list"></i>
        </button>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2">
          <%= adminRoleLabel || (adminRole === 'owner' ? 'المالك' : adminRole === 'assistant_owner' ? 'مساعد المالك' : adminRole === 'manager' ? 'مدير' : 'مسؤول') %>
        </span>
        <a href="/admin/logout" class="btn btn-danger border-2 rounded-pill px-3 fw-bold shadow-sm">خروج</a>
      </div>
    </div>
  </nav>

  <div class="admin-layout">
    <aside class="admin-sidebar" id="adminSidebar">
      <div class="mb-4 d-none d-lg-block">
        <p class="text-muted small fw-bold px-3 mb-2">القائمة الرئيسية</p>
      </div>
      <nav>
        <a href="/admin" class="nav-link-custom <%= activePath === '/admin' ? 'active' : '' %>">
          <i class="bi bi-speedometer2"></i>
          <span>لوحة الإحصائيات</span>
        </a>
        <a href="/admin/admins" class="nav-link-custom <%= activePath === '/admin/admins' ? 'active' : '' %>">
          <i class="bi bi-person-gear"></i>
          <span>إدارة المسؤولين</span>
        </a>
        <a href="/admin/students" class="nav-link-custom <%= activePath === '/admin/students' ? 'active' : '' %>">
          <i class="bi bi-people"></i>
          <span>إدارة الطلاب</span>
        </a>
        <a href="/admin/professors" class="nav-link-custom <%= activePath === '/admin/professors' ? 'active' : '' %>">
          <i class="bi bi-mortarboard"></i>
          <span>إدارة الدكاترة</span>
        </a>
        <a href="/admin/lectures" class="nav-link-custom <%= activePath === '/admin/lectures' ? 'active' : '' %>">
          <i class="bi bi-file-earmark-slides"></i>
          <span>إدارة المحاضرات</span>
        </a>
        <a href="/admin/sheets" class="nav-link-custom <%= activePath === '/admin/sheets' ? 'active' : '' %>">
          <i class="bi bi-file-earmark-check"></i>
          <span>إدارة الشيتات</span>
        </a>
        <hr class="my-4 opacity-10">
        <a href="/dashboard" class="nav-link-custom text-primary">
          <i class="bi bi-box-arrow-up-right"></i>
          <span>عرض الموقع</span>
        </a>
      </nav>
    </aside>

    <main class="admin-content">
