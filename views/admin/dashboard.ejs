<%- include('../partials/admin_top', { title: title, activePath: activePath, adminRole: adminRole, adminRoleLabel: adminRoleLabel }) %>
<div class="container pb-5">
  <div class="dashboard-header">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <h1 class="display-6 fw-bold mb-2">لوحة التحكم الإدارية</h1>
        <p class="lead mb-0 opacity-75">مرحبًا بك في مركز إدارة محاضراتي. يمكنك إدارة المسؤولين والطلاب والدكاترة والمحتوى التعليمي من هنا.</p>
      </div>
      <div class="col-lg-4 text-center d-none d-lg-block">
        <i class="bi bi-gear-wide-connected text-white opacity-25" style="font-size: 6rem;"></i>
      </div>
    </div>
  </div>

  <div class="row row-cols-2 row-cols-lg-5 g-4 mb-5">
    <div class="col">
      <div class="card border-0 shadow-sm p-3 h-100 stat-card stat-card--admins">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-primary bg-opacity-10 text-primary rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
            <i class="bi bi-person-gear fs-4"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0 lh-1"><%= stats.adminsCount %></h3>
            <p class="text-muted small mb-0 mt-1">مسؤول</p>
          </div>
        </div>
      </div>
    </div>

    <div class="col">
      <div class="card border-0 shadow-sm p-3 h-100 stat-card stat-card--students">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-warning bg-opacity-10 text-warning rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
            <i class="bi bi-people-fill fs-4"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0 lh-1"><%= stats.studentsCount %></h3>
            <p class="text-muted small mb-0 mt-1">طالب</p>
          </div>
        </div>
      </div>
    </div>

    <div class="col">
      <div class="card border-0 shadow-sm p-3 h-100 stat-card stat-card--professors">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-primary bg-opacity-10 text-primary rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
            <i class="bi bi-mortarboard-fill fs-4"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0 lh-1"><%= stats.professorsCount %></h3>
            <p class="text-muted small mb-0 mt-1">دكتور</p>
          </div>
        </div>
      </div>
    </div>

    <div class="col">
      <div class="card border-0 shadow-sm p-3 h-100 stat-card stat-card--lectures">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-info bg-opacity-10 text-info rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
            <i class="bi bi-file-earmark-slides-fill fs-4"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0 lh-1"><%= stats.lecturesCount %></h3>
            <p class="text-muted small mb-0 mt-1">محاضرة</p>
          </div>
        </div>
      </div>
    </div>

    <div class="col">
      <div class="card border-0 shadow-sm p-3 h-100 stat-card stat-card--sheets">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-success bg-opacity-10 text-success rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
            <i class="bi bi-file-earmark-check-fill fs-4"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0 lh-1"><%= stats.sheetsCount %></h3>
            <p class="text-muted small mb-0 mt-1">شيت</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-4 col-md-6">
      <div class="card action-card action-card--admins h-100 border-0">
        <div class="card-body d-flex flex-column p-4 p-xl-5">
          <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mb-4 shadow-sm align-self-start" style="width: 78px; height: 78px;">
            <i class="bi bi-person-gear fs-1"></i>
          </div>
          <h4 class="fw-bold mb-3">إدارة المسؤولين</h4>
          <a href="/admin/admins" class="btn btn-admins text-white w-100 rounded-pill py-3 mt-auto shadow-sm fw-bold">فتح القسم</a>
        </div>
      </div>
    </div>

    <div class="col-lg-4 col-md-6">
      <div class="card action-card action-card--warning h-100 border-0">
        <div class="card-body d-flex flex-column p-4 p-xl-5">
          <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center mb-4 shadow-sm align-self-start" style="width: 78px; height: 78px;">
            <i class="bi bi-people-fill fs-1"></i>
          </div>
          <h4 class="fw-bold mb-3">إدارة الطلاب</h4>
          <a href="/admin/students" class="btn btn-warning text-white w-100 rounded-pill py-3 mt-auto shadow-sm fw-bold">فتح القسم</a>
        </div>
      </div>
    </div>

    <div class="col-lg-4 col-md-6">
      <div class="card action-card action-card--primary h-100 border-0">
        <div class="card-body d-flex flex-column p-4 p-xl-5">
          <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mb-4 shadow-sm align-self-start" style="width: 78px; height: 78px;">
            <i class="bi bi-mortarboard-fill fs-1"></i>
          </div>
          <h4 class="fw-bold mb-3">إدارة الدكاترة</h4>
          <a href="/admin/professors" class="btn btn-primary text-white w-100 rounded-pill py-3 mt-auto shadow-sm fw-bold">فتح القسم</a>
        </div>
      </div>
    </div>

    <div class="col-lg-6 col-md-6">
      <div class="card action-card action-card--info h-100 border-0">
        <div class="card-body d-flex flex-column p-4 p-xl-5">
          <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center mb-4 shadow-sm align-self-start" style="width: 78px; height: 78px;">
            <i class="bi bi-file-earmark-slides-fill fs-1"></i>
          </div>
          <h4 class="fw-bold mb-3">إدارة المحاضرات</h4>
          <a href="/admin/lectures" class="btn btn-info text-white w-100 rounded-pill py-3 mt-auto shadow-sm fw-bold">فتح القسم</a>
        </div>
      </div>
    </div>

    <div class="col-lg-6 col-md-6">
      <div class="card action-card action-card--success h-100 border-0">
        <div class="card-body d-flex flex-column p-4 p-xl-5">
          <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center mb-4 shadow-sm align-self-start" style="width: 78px; height: 78px;">
            <i class="bi bi-file-earmark-check-fill fs-1"></i>
          </div>
          <h4 class="fw-bold mb-3">إدارة الشيتات</h4>
          <a href="/admin/sheets" class="btn btn-success text-white w-100 rounded-pill py-3 mt-auto shadow-sm fw-bold">فتح القسم</a>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/admin_bottom', { flash: null }) %>
