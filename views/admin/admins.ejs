<%- include('../partials/admin_top', { title: title, activePath: activePath, adminRole: adminRole, adminRoleLabel: adminRoleLabel }) %>
<div class="container pb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
      <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
        <i class="bi bi-person-gear fs-4"></i>
      </div>
      <div>
        <h2 class="fw-bold mb-0">إدارة المسؤولين</h2>
        <p class="text-muted small mb-0">إضافة وعرض وتعديل حسابات المسؤولين حسب الصلاحيات</p>
      </div>
    </div>
    <a href="/admin" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
      <i class="bi bi-arrow-right me-1"></i> لوحة التحكم
    </a>
  </div>

  <div class="card p-4 border-0 shadow-sm mb-5">
    <% if (canManageAdmins) { %>
    <h5 class="fw-bold mb-4 text-primary">
      <i class="bi <%= editAdmin ? 'bi-pencil-square' : 'bi-person-plus' %> me-2"></i>
      <%= editAdmin ? 'تعديل مسؤول' : 'إضافة مسؤول جديد' %>
    </h5>

    <form action="<%= editAdmin ? ('/admin/admins/update/' + editAdmin.admin_id) : '/admin/admins/add' %>" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label small fw-bold">اسم المستخدم</label>
          <input type="text" name="admin_name" class="form-control" value="<%= editAdmin ? editAdmin.admin_name : '' %>" placeholder="اسم المسؤول">
        </div>
        <div class="col-md-4">
          <label class="form-label small fw-bold">الدور</label>
          <% const selectedRole = (editAdmin && editAdmin.role) || ((assignableRoles && assignableRoles[0]) || 'admin'); %>
          <% const roleDisplay = { owner: 'المالك', assistant_owner: 'مساعد المالك', manager: 'مدير', admin: 'مسؤول' }; %>
          <select name="role" class="form-select">
            <% (assignableRoles || []).forEach((roleKey) => { %>
            <option value="<%= roleKey %>" <%= selectedRole === roleKey ? 'selected' : '' %>><%= roleDisplay[roleKey] || roleKey %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <p class="text-muted small mt-3 mb-0">كود المسؤول (ID) يُولّد تلقائيًا من قاعدة البيانات ولا يمكن تعديله من الموقع.</p>

      <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary text-white fw-bold px-5 rounded-pill shadow-sm">
          <%= editAdmin ? 'حفظ التعديلات' : 'إضافة المسؤول' %>
        </button>
        <% if (editAdmin) { %>
        <a href="/admin/admins" class="btn btn-outline-secondary rounded-pill px-4">إلغاء التعديل</a>
        <% } %>
      </div>
    </form>
    <% } else { %>
    <h5 class="fw-bold mb-2 text-primary"><i class="bi bi-eye me-2"></i>عرض المسؤولين</h5>
    <p class="text-muted mb-0">ليس لديك صلاحية إضافة أو تعديل أو حذف حسابات المسؤولين.</p>
    <% } %>
  </div>

  <div class="row align-items-center mb-4 g-3">
    <div class="col-md-5">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-list-ul text-primary"></i>
        <h5 class="fw-bold mb-0">قائمة المسؤولين</h5>
      </div>
    </div>
    <div class="col-md-7">
      <form method="get" action="/admin/admins" class="d-flex gap-2 align-items-center">
        <div class="input-group search-group shadow-sm rounded-pill overflow-hidden">
          <span class="input-group-text border-0 ps-3"><i class="bi bi-search text-muted"></i></span>
          <input type="text" name="q" class="form-control border-0 py-2 small" placeholder="ابحث بالاسم أو الكود..." value="<%= searchTerm || '' %>">
        </div>
        <select name="page_size" class="form-select form-select-sm w-auto rounded-pill px-3">
          <% pageSizeOptions.forEach((size) => { %>
          <option value="<%= size %>" <%= pagination && pagination.pageSize === size ? 'selected' : '' %>><%= size %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-outline-primary rounded-pill px-3">بحث</button>
      </form>
    </div>
  </div>

  <% const roleBadgeClasses = {
    owner: 'bg-danger-subtle text-danger border border-danger-subtle',
    assistant_owner: 'bg-warning-subtle text-warning border border-warning-subtle',
    manager: 'bg-info-subtle text-info border border-info-subtle',
    admin: 'bg-primary-subtle text-primary border border-primary-subtle'
  }; %>

  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>الكود</th>
          <th>الاسم</th>
          <th>الدور</th>
          <th class="text-center">إجراءات</th>
        </tr>
      </thead>
      <tbody>
        <% admins.forEach((admin) => { %>
        <tr class="shadow-sm">
          <td><span class="badge status-badge font-monospace"><%= admin.admin_id %></span></td>
          <td><span class="fw-bold"><%= admin.admin_name %></span></td>
          <td>
            <span class="badge rounded-pill <%= roleBadgeClasses[admin.role] || roleBadgeClasses.admin %>"><%= admin.roleLabel || admin.role %></span>
          </td>
          <td class="text-center">
            <% if (admin.canEdit || admin.canDelete) { %>
            <div class="btn-group shadow-sm rounded-pill overflow-hidden">
              <% if (admin.canEdit) { %>
              <a class="btn btn-warning btn-sm text-white px-3" href="/admin/admins?editId=<%= admin.admin_id %>"><i class="bi bi-pencil-square"></i></a>
              <% } %>
              <% if (admin.canDelete) { %>
              <form action="/admin/admins/delete/<%= admin.admin_id %>" method="post" data-confirm="هل أنت متأكد من حذف هذا المسؤول نهائيًا؟">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-delete-soft btn-sm px-3"><i class="bi bi-trash3-fill"></i></button>
              </form>
              <% } %>
            </div>
            <% } else { %>
            <span class="text-muted small">عرض فقط</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (!admins.length) { %>
  <div class="text-center py-5 opacity-50">
    <i class="bi bi-person-x fs-1 d-block mb-3"></i>
    <h6>لا يوجد مسؤولون مسجلون حاليًا</h6>
  </div>
  <% } %>

  <%- include('../partials/admin_pagination', {
    pagination: pagination,
    searchTerm: searchTerm,
    basePath: '/admin/admins'
  }) %>
</div>

<%- include('../partials/admin_bottom', { flash: flash }) %>
