<%- include('../partials/admin_top', { title: title, activePath: activePath, adminRole: adminRole, adminRoleLabel: adminRoleLabel }) %>
<div class="container pb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
      <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
        <i class="bi bi-file-earmark-slides-fill fs-4"></i>
      </div>
      <div>
        <h2 class="fw-bold mb-0">إدارة المحاضرات</h2>
        <p class="text-muted small mb-0">رفع وتنظيم ملفات المحاضرات الأسبوعية</p>
      </div>
    </div>
    <a href="/admin" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
      <i class="bi bi-arrow-right me-1"></i> لوحة التحكم
    </a>
  </div>

  <div class="card p-4 border-0 shadow-sm mb-5">
    <h5 class="fw-bold mb-4 text-info"><i class="bi bi-cloud-arrow-up me-2"></i>رفع محاضرة جديدة</h5>

    <form action="/admin/lectures/add" method="post" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label small fw-bold">عنوان المحاضرة</label>
          <input type="text" name="lecture_name" class="form-control" placeholder="مثال: المحاضرة الأولى - مقدمة">
        </div>
        <div class="col-md-4">
          <label class="form-label small fw-bold">الدكتور المسؤول</label>
          <select name="professor_id" id="lecture_professor_id" class="form-select" required>
            <option value="">اختر دكتور...</option>
            <% professors.forEach((professor) => { %>
            <option value="<%= professor.professor_id %>"><%= professor.professor_name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label small fw-bold">المادة</label>
          <select name="subject_name" id="lecture_subject_name" class="form-select" required>
            <option value="">اختر المادة...</option>
          </select>
        </div>
      </div>

      <div class="row g-3 mt-1">
        <div class="col-md-4">
          <label class="form-label small fw-bold">القسم + السنة الدراسية</label>
          <select name="teaching_scope" id="lecture_teaching_scope" class="form-select" required>
            <option value="">اختر القسم والسنة...</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label small fw-bold">القسم المحدد</label>
          <input type="text" id="lecture_scope_major" class="form-control" placeholder="يتم تحديده بالاختيار" readonly>
        </div>
        <div class="col-md-4">
          <label class="form-label small fw-bold">السنة المحددة</label>
          <input type="text" id="lecture_scope_year" class="form-control" placeholder="يتم تحديدها بالاختيار" readonly>
        </div>
      </div>

      <div class="row g-3 mt-1">
        <div class="col-md-6">
          <label class="form-label small fw-bold">تاريخ المحاضرة (اختياري)</label>
          <input type="date" name="lecture_date" class="form-control">
        </div>
        <div class="col-md-6">
          <label class="form-label small fw-bold">ملف المحاضرة (PDF / PPT / PPTX)</label>
          <input type="file" name="lecture_file" class="form-control" accept=".pdf,.ppt,.pptx">
        </div>
      </div>

      <div class="mt-4">
        <button type="submit" class="btn btn-info text-white fw-bold px-5 rounded-pill shadow-sm">بدء الرفع الآن</button>
      </div>
    </form>
  </div>

  <div class="row align-items-center mb-4 g-3">
    <div class="col-md-5">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-collection-play text-info"></i>
        <h5 class="fw-bold mb-0">المحاضرات المتاحة حاليًا</h5>
      </div>
    </div>
    <div class="col-md-7">
      <form method="get" action="/admin/lectures" class="d-flex gap-2 align-items-center">
        <div class="input-group search-group shadow-sm rounded-pill overflow-hidden">
          <span class="input-group-text border-0 ps-3"><i class="bi bi-search text-muted"></i></span>
          <input type="text" name="q" class="form-control border-0 py-2 small" placeholder="ابحث باسم المحاضرة أو الدكتور..." value="<%= searchTerm || '' %>">
        </div>
        <select name="page_size" class="form-select form-select-sm w-auto rounded-pill px-3">
          <% pageSizeOptions.forEach((size) => { %>
          <option value="<%= size %>" <%= pagination && pagination.pageSize === size ? 'selected' : '' %>><%= size %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-outline-primary rounded-pill px-3">بحث</button>
      </form>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>اسم المحاضرة</th>
          <th>الدكتور</th>
          <th>المادة</th>
          <th>التاريخ</th>
          <th class="text-center">إجراءات</th>
        </tr>
      </thead>
      <tbody>
        <% lectures.forEach((lecture) => { %>
        <tr class="shadow-sm">
          <td>
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-file-earmark-pdf-fill text-danger fs-5"></i>
              <a class="fw-bold text-main text-decoration-none" href="/<%= lecture.lecture_file %>" target="_blank"><%= lecture.lecture_name %></a>
            </div>
          </td>
          <td>
            <span class="text-muted small fw-bold"><i class="bi bi-person-fill small me-1"></i><%= lecture.professor_name %></span>
          </td>
          <td><span class="badge bg-primary-subtle text-primary"><%= lecture.subject_name || '-' %></span></td>
          <td><span class="badge status-badge"><%= lecture.lecture_date %></span></td>
          <td class="text-center">
            <% if (canDeleteContent) { %>
            <form action="/admin/lectures/delete/<%= lecture.lecture_id %>" method="post" data-confirm="هل أنت متأكد من حذف هذه المحاضرة نهائيًا؟">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-delete-soft btn-sm px-3"><i class="bi bi-trash3-fill"></i></button>
            </form>
            <% } else { %>
            <span class="text-muted small">عرض فقط</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (!lectures.length) { %>
  <div class="text-center py-5 opacity-50">
    <i class="bi bi-folder-x fs-1 d-block mb-3"></i>
    <h6>لا يوجد محاضرات مضافة حاليًا</h6>
  </div>
  <% } %>

  <%- include('../partials/admin_pagination', {
    pagination: pagination,
    searchTerm: searchTerm,
    basePath: '/admin/lectures'
  }) %>
</div>

<script>
  (() => {
    const professors = <%- JSON.stringify(professors || []).replace(/</g, '\\u003c') %>;
    const professorSelect = document.getElementById('lecture_professor_id');
    const subjectSelect = document.getElementById('lecture_subject_name');
    const scopeSelect = document.getElementById('lecture_teaching_scope');
    const majorInput = document.getElementById('lecture_scope_major');
    const yearInput = document.getElementById('lecture_scope_year');

    if (!professorSelect || !subjectSelect || !scopeSelect || !majorInput || !yearInput) {
      return;
    }

    function clearScopeDetails() {
      majorInput.value = '';
      yearInput.value = '';
    }

    function fillScopeDetails() {
      const selectedOption = scopeSelect.options[scopeSelect.selectedIndex];
      if (!selectedOption || !selectedOption.value) {
        clearScopeDetails();
        return;
      }

      majorInput.value = selectedOption.getAttribute('data-major') || '';
      yearInput.value = selectedOption.getAttribute('data-year') || '';
    }

    function renderScopeOptions() {
      const selectedProfessor = professors.find((item) => String(item.professor_id) === String(professorSelect.value));
      subjectSelect.innerHTML = '<option value="">Select subject...</option>';
      subjectSelect.disabled = true;
      if (selectedProfessor && selectedProfessor.subject_name) {
        const subjectOption = document.createElement('option');
        subjectOption.value = selectedProfessor.subject_name;
        subjectOption.textContent = selectedProfessor.subject_name;
        subjectOption.selected = true;
        subjectSelect.appendChild(subjectOption);
        subjectSelect.disabled = false;
      }

      scopeSelect.innerHTML = '<option value="">Select major/year...</option>';
      scopeSelect.disabled = true;
      clearScopeDetails();

      if (!selectedProfessor || !Array.isArray(selectedProfessor.teaching_scopes)) {
        return;
      }

      selectedProfessor.teaching_scopes.forEach((scope) => {
        const option = document.createElement('option');
        option.value = scope.pair;
        option.textContent = scope.label;
        option.setAttribute('data-major', scope.major || '');
        option.setAttribute('data-year', scope.academic_year || '');
        scopeSelect.appendChild(option);
      });

      if (selectedProfessor.teaching_scopes.length) {
        scopeSelect.disabled = false;
      }
    }

    professorSelect.addEventListener('change', renderScopeOptions);
    scopeSelect.addEventListener('change', fillScopeDetails);
    renderScopeOptions();
  })();
</script>

<%- include('../partials/admin_bottom', { flash: flash }) %>
