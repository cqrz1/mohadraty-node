<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>محاضراتي - دخول الإدارة</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/admin-style.css?v=5.0">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
  <div class="login-bg">
    <div class="login-blob" style="top: -100px; left: -100px;"></div>
    <div class="login-blob" style="bottom: -100px; right: -100px; background: var(--secondary);"></div>
  </div>

  <nav class="navbar navbar-expand-lg fixed-top shadow-sm">
    <div class="container">
      <span class="navbar-brand fw-bold"><i class="bi bi-shield-lock-fill me-2"></i>محاضراتي <span class="small fw-light">| الإدارة</span></span>
    </div>
  </nav>

  <div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh; padding-top: 100px; padding-bottom: 50px;">
    <div class="row justify-content-center w-100 mx-auto">
      <div class="col-lg-4 col-md-6 mb-4 mx-auto">
        <div class="card login-container shadow-lg border-0">
          <div class="text-center mb-3">
            <div class="login-icon-box shadow-sm"><i class="bi bi-lock-fill"></i></div>
            <h2 class="fw-extrabold text-danger mb-1" style="font-weight: 800; font-size: 1.6rem;">مركز الإدارة</h2>
            <p class="text-muted small fw-medium mb-0">قم بتسجيل الدخول للتحكم في المنصة</p>
          </div>

          <form action="/admin/login" method="post">
            <div class="mb-2 text-end">
              <label class="form-label fw-bold small text-muted px-3 mb-1"><i class="bi bi-person me-1"></i> اسم المستخدم</label>
              <input type="text" name="username" class="form-control" placeholder="أدخل اسم المستخدم" value="<%= formData.username || '' %>">
            </div>

            <div class="mb-3 text-end">
              <label class="form-label fw-bold small text-muted px-3 mb-1"><i class="bi bi-key me-1"></i> كلمة المرور</label>
              <input type="password" name="password" class="form-control" placeholder="••••••••">
            </div>

            <button class="btn btn-danger w-100 py-3 mb-2 shadow-lg fw-bold rounded-pill" type="submit">دخول الإدارة</button>
          </form>

          <div class="pt-2 border-top border-opacity-10 text-center">
            <a href="/login" class="text-decoration-none text-primary small fw-bold">
              <i class="bi bi-arrow-right-circle me-1"></i>العودة لدخول الطلاب
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const msg = '<%- (message || "").replace(/'/g, "\\'") %>';
      if (msg) {
        Swal.fire({
          icon: 'error',
          title: 'تنبيه',
          text: msg,
          confirmButtonText: 'حسنًا',
          customClass: { confirmButton: 'btn btn-danger px-4 rounded-pill' },
          buttonsStyling: false
        });
      }
    });
  </script>
</body>
</html>
